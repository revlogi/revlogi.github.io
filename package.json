{
	"name": "revlogi-blog",
	"type": "module",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"build": "gleam run --module revlogi_blog",
		"test": "gleam build --warnings-as-errors && bun test tests",
		"probe:gleam": "bun run test",
		"dev": "gleam run --module dev",
		"serve": "bun run dev",
		"check": "gleam format --check src && gleam build --warnings-as-errors && biome check",
		"lint": "biome check --write",
		"format": "gleam format src && prettier -w . --cache"
	},
	"dependencies": {
		"katex": "^0.17.0",
		"markdown-it": "^14.1.0",
		"markdown-it-anchor": "^9.2.0",
		"markdown-it-footnote": "^4.0.0",
		"markdown-it-texmath": "^1.0.0",
		"shiki": "^1.24.0",
		"yaml": "^2.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.8",
		"prettier": "^3.8.4"
	}
}
